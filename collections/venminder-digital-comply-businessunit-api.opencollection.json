{
  "opencollection": "1.0.0",
  "info": {
    "name": "Venminder OpenApi BusinessUnit API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "BusinessUnit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Provides a list of business unit related informtion.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/BusinessUnitInformation/GetBusinessUnits"
          },
          "docs": "Provides a list of business units with their assigned products and users as well as a list of unassigned products and users."
        }
      ]
    }
  ],
  "bundled": true
}